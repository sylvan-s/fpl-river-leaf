# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local caches — regenerated on demand, never authoritative
fpl_history_cache.sqlite
fpl_history_cache.sqlite-journal
*.sqlite-journal

# Generated dashboard output — rebuild with `python3 build_dashboard.py`
FPL_DIAGNOSTICS.html
FPL_DIAGNOSTICS_artifact.html
dash.js

# Scratch
_wtest.txt
.DS_Store
*.tmp

# fetched at build time, never committed — see DASHBOARD_PLAN.md
.cache_merged_gw.csv
.cache_merged_gw_*.csv

# Secrets — never committed under any circumstance
git_access.md
.git-credentials

# Raw per-gameweek FPL API pulls — bulky, regenerable from the API. The
# derived prediction_tracker.json (small, walk-forward summary) IS committed,
# so the season's track record survives even if this cache is cleared.
live_gw_cache.json

# Exploratory multi-user/Supabase work-in-progress — not yet part of this
# repo's actual pipeline. Untracked locally, but got swept into a scheduled
# task's commit on 29 Aug 2026 because safe_git_commit.sh picks up every
# untracked file; ignored from here on so that doesn't happen again.
multi-user_plan.md
supabase/
